{
  "name": "coursewatcher",
  "version": "1.3.1",
  "description": "A CLI tool and web interface for tracking progress in downloaded video courses",
  "main": "dist/app/server/start-server.js",
  "bin": {
    "coursewatcher": "./dist/app/cli/main.js"
  },
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "npm run clean && npm run build:server && npm run build:web",
    "build:server": "tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "dev": "cross-env NODE_ENV=development tsx watch src/app/cli/main.ts",
    "start": "node dist/app/cli/main.js",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.web.json --noEmit"
  },
  "keywords": [
    "video",
    "course",
    "tracker",
    "education",
    "cli",
    "progress",
    "learning",
    "tutorial"
  ],
  "author": "Serhii Shtokal <serhiishtokal@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/serhiishtokal/CourseWatcher.git"
  },
  "homepage": "https://github.com/serhiishtokal/CourseWatcher#readme",
  "bugs": {
    "url": "https://github.com/serhiishtokal/CourseWatcher/issues"
  },
  "files": [
    "dist/"
  ],
  "dependencies": {
    "better-sqlite3": "^11.6.0",
    "chalk": "^4.1.2",
    "commander": "^12.1.0",
    "express": "^4.21.1",
    "open": "^8.4.2",
    "plyr": "^3.8.4",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-router": "^7.14.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^5.0.3",
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/supertest": "^6.0.3",
    "@vitejs/plugin-react": "^6.0.1",
    "cross-env": "^10.1.0",
    "jsdom": "^27.0.0",
    "supertest": "^7.0.0",
    "tsx": "^4.20.6",
    "typescript": "^6.0.3",
    "vite": "^8.0.8",
    "vitest": "^4.1.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
